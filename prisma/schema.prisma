datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Machine {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  location    String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  tickets     Ticket[]

  @@map("machines")
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String?       @unique
  phone           String?
  role            String        @default("TECHNICIAN") // OPERATOR, TECHNICIAN, ADMIN
  dutyStatus      String        @default("ON_DUTY")    // ON_DUTY, ON_BREAK, OFF_DUTY
  lineUserId      String?       // For 1-on-1 LINE push notification
  createdAt       DateTime      @default(now())
  assignedTickets Ticket[]      @relation("TechnicianTickets")
  events          TicketEvent[]

  @@map("users")
}

model Ticket {
  id                     String        @id @default(cuid())
  ticketNo               String        @unique
  machineId              String
  machine                Machine       @relation(fields: [machineId], references: [id])
  reporterName           String
  reporterPhone          String?
  issueDesc              String
  urgency                String        @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  status                 String        @default("CREATED") // CREATED, ACCEPTED, IN_PROGRESS, RESOLVED, REOPENED
  
  technicianId           String?
  technician             User?         @relation("TechnicianTickets", fields: [technicianId], references: [id])
  
  assignmentTimeout      DateTime?
  
  // Explicit Timestamps for full lifecycle tracking
  acceptedAt             DateTime?     // เวลาที่ช่างกดรับงาน
  startedAt              DateTime?     // เวลาที่เริ่มซ่อมหน้างาน
  resolvedAt             DateTime?     // เวลาที่ปิดงาน/ส่งงาน
  
  photoBeforeUrl         String?       // รูปถ่ายตอนแจ้ง
  photoAfterUrl          String?       // รูปถ่ายหลังซ่อมเสร็จ
  sparePartsUsed         String?       // อะไหล่ที่เปลี่ยน
  repairDurationMinutes  Int?          // เวลาซ่อมจริง (นาที)
  startQrVerified        Boolean       @default(false)
  finishQrVerified       Boolean       @default(false)
  
  resolutionNotes        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  
  events                 TicketEvent[]

  @@map("tickets")
}

model TicketEvent {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorName   String
  eventType   String   // CREATED, ASSIGNED, TIMEOUT_ESCALATED, ACCEPTED, STARTED, RESOLVED, REOPENED
  description String
  createdAt   DateTime @default(now())
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@map("ticket_events")
}
